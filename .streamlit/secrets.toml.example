# Copiar como secrets.toml (NO se sube a GitHub). En local, si falta algo, se lee del .env de LilOS.
SUPABASE_URL = "https://xxxxx.supabase.co"
SUPABASE_SERVICE_KEY = "sb_secret_..."
# Asistente de IA (gratis). Por defecto, plan gratuito de Google Gemini: clave de https://aistudio.google.com
GEMINI_API_KEY = "..."
# Opcional, para usar otro proveedor compatible con OpenAI (Groq, OpenRouter, Ollama en local…):
# IA_API_KEY = "..."
# IA_BASE_URL = "https://api.groq.com/openai/v1"
# IA_MODELOS = "openai/gpt-oss-120b"
# Opcional: búsquedas en internet (plan gratuito de https://tavily.com). Sin ella, se busca en la Wikipedia.
# TAVILY_API_KEY = "tvly-..."
# Avisos por email cuando vence un mantenimiento (cuenta de Google Workspace con contraseña de aplicación)
# SMTP_USUARIO = "ops@lilobrunch.com"
# SMTP_CLAVE = "xxxx xxxx xxxx xxxx"
# AVISOS_PARA = "ops@lilobrunch.com"
# Recomendable si la app se publica en internet (Streamlit Cloud): se pide antes del PIN personal
APP_PASSWORD = ""
# Opcional: contraseña para compartir la app (muro del máster). Entra como invitado: lo ve, pero no guarda nada
# INVITADO_PASSWORD = ""
# Opcional (solo admin): repartir encargos de Rumbo desde una base de datos de Notion
# NOTION_TOKEN = "ntn_..."
# NOTION_RUMBO_DB = "https://www.notion.so/...enlace de la base..."
